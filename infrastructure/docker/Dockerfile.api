# syntax=docker/dockerfile:1.12
FROM node:22.22.0-alpine3.23@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cobranzapp/contracts build && pnpm --filter @cobranzapp/api build
RUN pnpm --filter @cobranzapp/api deploy --prod --legacy /opt/app

FROM node:22.22.0-alpine3.23@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34 AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S -g 10001 app && adduser -S -D -H -u 10001 -G app app
COPY --from=build --chown=app:app /opt/app ./
USER 10001:10001
EXPOSE 3001
CMD ["node", "dist/server.js"]
