POSTGRES_DB=cobranzapp
POSTGRES_USER=cobranzapp_runtime
POSTGRES_PASSWORD=replace-with-a-long-random-secret
APP_DATABASE_USER=cobranzapp_app
APP_DATABASE_PASSWORD=replace-with-a-different-long-random-secret
WORKER_DATABASE_USER=cobranzapp_worker
WORKER_DATABASE_PASSWORD=replace-with-another-long-random-secret
ALLOWED_WEB_ORIGINS=https://cobranzaap.tech
SESSION_TTL_HOURS=8
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Separate key for tenant-scoped borrower identity lookup and encryption.
BORROWER_IDENTITY_KEY=replace-with-a-long-random-secret
BORROWER_DOCUMENTS_ROOT=/var/lib/cobranzapp/documents
# Leave empty until the shared verification network is legally approved and operated.
VERIFICATION_NETWORK_HMAC_KEY=
PUBLIC_WEB_URL=https://cobranzaap.tech
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=10000
WORKER_LEASE_SECONDS=30
