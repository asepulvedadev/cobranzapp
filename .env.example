NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_URL=postgresql://cobranzapp_app:replace-with-local-dev-password@localhost:5432/cobranzapp
MIGRATION_DATABASE_URL=postgresql://cobranzapp:replace-with-local-migration-password@localhost:5432/cobranzapp
APP_DATABASE_USER=cobranzapp_app
APP_DATABASE_PASSWORD=replace-with-local-dev-password
ALLOWED_WEB_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=8760
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Separate key for tenant-scoped borrower identity lookup and encryption.
BORROWER_IDENTITY_KEY=replace-with-a-long-random-secret
BORROWER_DOCUMENTS_ROOT=.data/documents
HERMES_OCR_URL=http://127.0.0.1:8650/v1/chat/completions
HERMES_OCR_API_KEY=replace-with-the-dedicated-hermes-api-server-key
HERMES_OCR_TIMEOUT_MS=45000
# Leave empty until the Colombian privacy policy and participant agreements are approved.
VERIFICATION_NETWORK_HMAC_KEY=
API_PROXY_URL=http://127.0.0.1:3001
PUBLIC_WEB_URL=http://localhost:3000
POSTGRES_DB=cobranzapp
POSTGRES_USER=cobranzapp
POSTGRES_PASSWORD=replace-with-local-postgres-password
