{
  "expo": {
    "name": "cobranzapp",
    "slug": "cobranzapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#171717"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cobranzapp.mobile",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es_CO"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.cobranzapp.mobile"
    },
    "extra": {
      "defaultLocale": "es-CO"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a cobranzapp seleccionar documentos y fotos de perfil para el expediente del cliente.",
          "cameraPermission": "Permite a cobranzapp tomar fotos del documento y de la foto de perfil del cliente."
        }
      ]
    ]
  }
}
