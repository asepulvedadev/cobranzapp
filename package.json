{
  "name": "cobranzapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm --parallel --filter @cobranzapp/api --filter @cobranzapp/web --filter @cobranzapp/worker dev",
    "dev:mobile": "pnpm --filter @cobranzapp/mobile start",
    "db:bootstrap-developer": "pnpm --filter @cobranzapp/api db:bootstrap-developer",
    "db:migrate": "pnpm --filter @cobranzapp/api db:migrate",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:check": "pnpm security:audit && node scripts/verify-mobile-security-overrides.cjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "compose:up": "docker compose -f compose.dev.yaml up -d --build",
    "compose:down": "docker compose -f compose.dev.yaml down",
    "compose:logs": "docker compose -f compose.dev.yaml logs -f"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3"
  }
}
