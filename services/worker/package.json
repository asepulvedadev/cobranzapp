  "dependencies": {
    "@cobranzapp/hermes-ocr": "workspace:*",
    "@cobranzapp/hermes-routes": "workspace:*",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
