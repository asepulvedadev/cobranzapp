{
  "name": "@cobranzapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:bootstrap-developer": "tsx src/database/bootstrap-developer.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cobranzapp/contracts": "workspace:*",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
